{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Sonarly",
  "colors": {
    "primary": "#000000",
    "light": "#5E5E5E",
    "dark": "#000000"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/dark.png",
    "dark": "/logo/light.png"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "Error Tracking",
            "pages": ["integrations/sentry"]
          },
          {
            "group": "Observability",
            "pages": [
              "integrations/datadog",
              "integrations/grafana",
              "integrations/signoz",
              "integrations/cloudwatch",
              "integrations/mezmo"
            ]
          },
          {
            "group": "Incident Management",
            "pages": [
              "integrations/pagerduty",
              "integrations/incidentio",
              "integrations/opsgenie"
            ]
          },
          {
            "group": "Code & PRs",
            "pages": [
              "integrations/github",
              "integrations/gitlab"
            ]
          },
          {
            "group": "Notifications",
            "pages": [
              "integrations/slack",
              "integrations/discord"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "features/ai-analysis",
              "features/deduplication",
              "features/pr-generation",
              "features/severity"
            ]
          },
          {
            "group": "Platform",
            "pages": ["security", "faq"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:founders@sonarly.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://sonarly.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/sonarly-dev",
      "x": "https://x.com/SonarlyDev",
      "discord": "https://discord.gg/9XDVzde4G4"
    }
  }
}
